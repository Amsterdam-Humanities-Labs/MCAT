{
  "name": "mcat",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:app": "cd packages/app/backend && venv/bin/python mcat/app.py",
    "dev:app:mock": "cd packages/app/backend && MCAT_MOCK=1 venv/bin/python mcat/app.py",
    "dev:website": "pnpm --filter website dev",
    "build": "pnpm --filter frontend build",
    "build:linux": "./packages/app/build/build-linux.sh",
    "check": "pnpm --filter frontend check",
    "test": "packages/app/backend/venv/bin/python -m pytest",
    "clean": "rm -rf packages/app/frontend/dist packages/app/backend/build packages/app/backend/dist packages/app/build/MCAT.AppDir packages/app/build/MCAT-x86_64.AppImage",
    "start": "cd packages/app/backend && venv/bin/python mcat/app.py"
  }
}
