{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mcat",
  "version": "0.1.0",
  "identifier": "com.mcat.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter frontend dev -- --port 5180",
    "beforeBuildCommand": "pnpm --filter frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "MCAT",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
